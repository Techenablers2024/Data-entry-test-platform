{
  "expo": {
    "owner": "muralidhara",
    "name": "DataEntry Pro",
    "slug": "dataentry-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dataentrypro",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow DataEntry Pro to save screenshots to your gallery."
        }
      ],
      "expo-sharing"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.dataentry.pro"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
